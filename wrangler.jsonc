{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tpc-recruitment-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Variables públicas (no secretas). Las claves se definen con `wrangler secret put`
  // o en el panel de Cloudflare. NUNCA guarde credenciales reales aquí.
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "TPC Recruitment Hub"
  },
  // Ambiente de PRUEBAS (Worker separado, conectado al proyecto Supabase de pruebas).
  // Se publica con: npx opennextjs-cloudflare deploy --env test
  // Nunca apunte este ambiente a la base de datos de producción.
  "env": {
    "test": {
      "name": "tpc-recruitment-hub-test",
      "vars": {
        "NEXT_PUBLIC_APP_NAME": "TPC Recruitment Hub (PRUEBAS)"
      }
    }
  }
}
